{
  "name": "pos-system",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.e2e.json",
    "test": "vitest run",
    "e2e": "playwright test --project=regression",
    "e2e:ui": "playwright test --ui --project=regression",
    "e2e:headed": "playwright test --project=regression --headed",
    "e2e:debug": "PWDEBUG=1 playwright test --project=debug --headed",
    "test:e2e": "playwright test --project=regression",
    "test:smoke": "playwright test --project=smoke",
    "test:regression": "playwright test --project=regression",
    "test:demo": "playwright test --project=demo",
    "test:debug": "PWDEBUG=1 playwright test --project=debug --headed",
    "test:ui": "playwright test --ui --project=regression",
    "test:headed": "playwright test --project=regression --headed",
    "test:training": "playwright test --project=training",
    "e2e:report": "playwright show-report ../playwright-report"
  },
  "dependencies": {
    "@ant-design/icons": "^6.2.5",
    "@tanstack/react-query": "^5.101.0",
    "antd": "^6.4.3",
    "axios": "^1.17.0",
    "dayjs": "^1.11.21",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.17.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
